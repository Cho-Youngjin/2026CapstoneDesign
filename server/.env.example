# server/.env로 복사한 뒤 실제 값을 채운다. server/.env는 .gitignore 대상이라 커밋되지 않는다.

# 공공데이터포털 (data.go.kr) 서비스키 — Encoding 버전 사용(마이페이지에 표시된 값을 그대로,
# URL 디코딩하지 말고 붙여넣는다. DataGoKrHttpClient가 이 값을 추가로 인코딩하지 않고 그대로
# 쿼리에 실으므로, 값 자체가 이미 퍼센트 인코딩된 Encoding 버전이어야 한다).
DATA_GO_KR_SERVICE_KEY=

# Google Cloud (Translation, Places) 서버용 API 키
GOOGLE_SERVER_API_KEY=

# 한국수출입은행 환율 API 키
KOREA_EXIM_API_KEY=

# OSRM(도로 스냅/해외 매핑) — osrm/README.md 참고. 비워 두면 해당 기능은 실패 응답으로 동작한다.
OSRM_BASE_URL=http://localhost:5001
OSRM_BASE_URL_JP=http://localhost:5002
